#!/bin/sh
# push 직전에 실행된다. setup.sh가 core.hooksPath를 이 폴더로 돌려 두면 켜진다.
# 1) 커밋 이메일이 설정돼 있고, 공개해도 되는 주소인지 확인한다.
# 2) main으로 직접 push하면 멈추고 브랜치 + PR을 안내한다. (GitHub ruleset도 거부한다)
# 3) 원격이 앞서 있으면 멈추고 git pull을 안내한다.
# 4) merge 커밋이 섞여 있으면 멈추고 rebase를 안내한다. (main은 linear history만 받는다)

email=$(git config user.email 2>/dev/null || true)
allow=$(git config --bool team.allowPublicEmail 2>/dev/null || echo false)

case "$email" in
  *@users.noreply.github.com) ;;
  "")
    echo "커밋 이메일이 설정돼 있지 않습니다. 저장소 루트에서  sh setup.sh  를 실행해 주세요."
    exit 1 ;;
  *)
    if [ "$allow" != "true" ]; then
      echo "커밋 이메일 $email 은(는) 공개 저장소에 그대로 남습니다."
      echo "GitHub noreply 주소로 바꾸려면:  sh setup.sh"
      echo "이 주소를 그대로 쓰려면:        git config team.allowPublicEmail true"
      exit 1
    fi ;;
esac

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "main에는 직접 push하지 않습니다. 브랜치를 만들어 PR로 올려 주세요:"
    echo "  git switch -c <github-id>/<주제>"
    echo "  git push"
    echo "  gh pr create --fill   (또는 push 출력의 링크에서 PR 생성)"
    echo "이미 main에 커밋했다면:  git switch -c <github-id>/<주제>  로 그 커밋을 새 브랜치로 옮기고,"
    echo "  git branch -f main origin/main  으로 로컬 main을 원격에 맞춥니다."
    exit 1
  fi
  [ "$remote_sha" = "$zero" ] && continue
  [ "$local_sha" = "$zero" ] && continue

  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "원격에 내가 받지 않은 커밋이 있습니다. 먼저 실행:  git pull"
    exit 1
  fi

  merges=$(git rev-list --merges "$remote_sha..$local_sha" 2>/dev/null | head -1)
  if [ -n "$merges" ]; then
    echo "merge 커밋이 섞여 있어 main에서 거부됩니다. 다음을 실행한 뒤 다시 push 해 주세요:"
    echo "  git pull --rebase origin main"
    exit 1
  fi
done

exit 0
